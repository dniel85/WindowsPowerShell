{
    "PowerShell Comment Help": {
        "prefix": "pshelp",
        "body": [
            "<#",
            ".SYNOPSIS",
            "    ${1:Short description}",
            "",
            ".DESCRIPTION",
            "    ${2:Detailed description}",
            "",
            ".PARAMETER ${3:ParameterName}",
            "    ${4:Parameter description}",
            "",
            ".EXAMPLE",
            "    ${5:Example usage}",
            "",
            ".NOTES",
            "    Author: ${6:Darrell Nielsen}",
            "    Created: ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}",
            "    Version: 1.0",
            "",
            "TAGS:",
            "    ${7:Tag1}",
            "#>"
        ],
        "description": "PowerShell comment help template"
    },

    "PowerShell Advanced Function": {
        "prefix": "psfunc",
        "body": [
           "function ${1:Get-Something} {",
            "    <#",
            "    .SYNOPSIS",
            "      ${2:Short function summary}",
            "    .DESCRIPTION",
            "      ${3:Longer function description}",
            "    .PARAMETER ${4:Name}",
            "      ${5:Parameter description}",
            "    .EXAMPLE",
            "      ${1:Get-Something} -${4:Name} value",
            "    .INPUTS",
            "      ${6:Input type or None}",
            "    .OUTPUTS",
            "      ${7:Output type or None}",
            "    .NOTES",
            "      Author: Darrell Nielsen",
            "    #>",
            "    [CmdletBinding(SupportsShouldProcess)]",
            "    param(",
            "        [Parameter(Mandatory = \\$true,",
            "                   ValueFromPipeline = \\$true,",
            "                   ValueFromPipelineByPropertyName = \\$true,",
            "                   Position = 0)]",
            "        [ValidateNotNullOrEmpty()]",
            "        [string]\\$${4:Name}",
            "    )",
            "",
            "    begin {",
            "        Set-StrictMode -Version Latest",
            "        \\$ErrorActionPreference = 'Stop'",
            "        ${8:# Begin block}",
            "    }",
            "",
            "    process {",
            "        try {",
            "            if (\\$PSCmdlet.ShouldProcess(\\$${4:Name}, '${9:Perform action}')) {",
            "                ${10:# Process block}",
            "            }",
            "        }",
            "        catch {",
            "            Write-Error \\$_.Exception.Message",
            "        }",
            "    }",
            "",
            "    end {",
            "        ${11:# End block}",
            "    }",
            "}"
        ],
        "description": "Advanced PowerShell function template with help, pipeline support, begin/process/end, and ShouldProcess"
    },

    "PowerShell Try Catch": {
        "prefix": "pstry",
        "body": [
            "try {",
            "    ${1:# code}",
            "}",
            "catch {",
            "    Write-Error \"${2:Error occurred}: $_\"",
            "}",
            "finally {",
            "    ${3:# cleanup}",
            "}"
        ],
        "description": "Try/Catch template"
    },

    "PowerShell Parameter Block": {
        "prefix": "psparam",
        "body": [
            "[Parameter(",
            "    Mandatory=$${1:true},",
            "    ValueFromPipeline=$${2:false},",
            "    ValueFromPipelineByPropertyName=$${3:false},",
            "    Position=${4:0}",
            ")]",
            "[ValidateNotNullOrEmpty()]",
            "[string]$${5:ParameterName}"
        ],
        "description": "Advanced parameter template"
    },
    
     "PowerShell Admin Check": {
        "prefix": "psisadministrator",
        "body": [
            "# Ensure script is running as Administrator",
            "if (-not ([Security.Principal.WindowsPrincipal] [Security.Principal.WindowsIdentity]::GetCurrent()",
            ").IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {",
            "    Write-Host \"${1:This script must be run as Administrator.}\" -ForegroundColor Red",
            "    exit 1",
            "}",
            ""
        ],
        "description": "Stops the script if not running as Administrator"
    },

    
    "PowerShell MiniScript Template": {
        "prefix": "PSScriptLightTemplate",
        "body": [
            "#requires -version 5.1",
            "<#",
            ".SYNOPSIS",
            "  ${1:Short summary of script}",
            ".DESCRIPTION",
            "  ${2:Longer description of script behavior}",
            ".EXAMPLE",
            "  ${3:.\\script.ps1}",
            ".NOTES",
            "  Author: Darrell Nielsen",
            "  Created: ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}",
            "#>",
            "",
            "[CmdletBinding()]",
            "param(",
            "    [Parameter(Mandatory = \\$false)]",
            "    [string]\\$ComputerName = \\$env:COMPUTERNAME,",
            "",
            "    [Parameter(Mandatory = \\$false)]",
            "    [switch]\\$Force",
            ")",
            "",
            "Set-StrictMode -Version Latest",
            "\\$ErrorActionPreference = 'Stop'",
            "",
            "\\$ScriptName = Split-Path -Leaf \\$PSCommandPath",
            "\\$ScriptPath = \\$PSCommandPath",
            "\\$ScriptRoot = \\$PSScriptRoot",
            "",
            "Write-Host \"Starting \\$ScriptName\" -ForegroundColor Cyan",
            "",
            "try {",
            "    ${4:# Logic here}",
            "}",
            "catch {",
            "    Write-Error \"[$ScriptName] $($_.Exception.Message)\"",
            "    exit 1",
            "}",
            "",
            "Write-Host \"Finished \\$ScriptName\" -ForegroundColor Green"
        ],
        "description": "Minimal PowerShell script template for daily use"
    },
     "PowerShell Production Script Template": {
        "prefix": "PSScriptFullTemplate",
        "body": [
            "#requires -version 5.1",
            "<#",
            ".SYNOPSIS",
            "  ${1:Short summary of script}",
            ".DESCRIPTION",
            "  ${2:Detailed description of what the script does}",
            ".PARAMETER ComputerName",
            "  Target computer name.",
            ".PARAMETER Force",
            "  Forces the action.",
            ".INPUTS",
            "  None.",
            ".OUTPUTS",
            "  Log file or console output.",
            ".NOTES",
            "  Version:        1.0",
            "  Author:         Darrell Nielsen",
            "  Creation Date:  ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}",
            "  Purpose/Change: Initial script development",
            "",
            "  Tags:",
            "    ${3:tag1, tag2}",
            "",
            ".EXAMPLE",
            "  .\\script.ps1 -ComputerName SERVER01",
            "#>",
            "",
            "[CmdletBinding(SupportsShouldProcess)]",
            "param(",
            "    [Parameter(Mandatory = \\$false)]",
            "    [ValidateNotNullOrEmpty()]",
            "    [string]\\$ComputerName = \\$env:COMPUTERNAME,",
            "",
            "    [Parameter(Mandatory = \\$false)]",
            "    [switch]\\$Force",
            ")",
            "",
            "Set-StrictMode -Version Latest",
            "\\$ErrorActionPreference = 'Stop'",
            "",
            "\\$ScriptVersion = '1.0'",
            "\\$ScriptName    = Split-Path -Leaf \\$PSCommandPath",
            "\\$ScriptPath    = \\$PSCommandPath",
            "\\$ScriptRoot    = \\$PSScriptRoot",
            "\\$RunAsAdmin    = \\$false",
            "\\$RequiresPowerShell7 = \\$false",
            "\\$EnableTranscript = \\$false",
            "\\$ExitCode = 0",
            "",
            "if (\\$RequiresPowerShell7 -and \\$PSVersionTable.PSVersion.Major -lt 7) {",
            "    Write-Error \"This script must be run in PowerShell 7.\"",
            "    exit 1",
            "}",
            "",
            "if (\\$RunAsAdmin) {",
            "    \\$currentUser = [Security.Principal.WindowsIdentity]::GetCurrent()",
            "    \\$principal = New-Object Security.Principal.WindowsPrincipal(\\$currentUser)",
            "",
            "    if (-not \\$principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {",
            "        Write-Error \"This script must be run as Administrator.\"",
            "        exit 1",
            "    }",
            "}",
            "",
            "if (Get-Module -ListAvailable -Name PSlogging) {",
            "    Import-Module PSlogging -ErrorAction Stop",
            "}",
            "else {",
            "    function Write-Log {",
            "        param(",
            "            [string]\\$Message,",
            "            [ValidateSet('INFO','WARN','ERROR','DEBUG')]",
            "            [string]\\$Level = 'INFO'",
            "        )",
            "        \\$timestamp = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'",
            "        Write-Host \"[\\$timestamp] [\\$Level] \\$Message\"",
            "    }",
            "}",
            "",
            "if (\\$EnableTranscript) {",
            "    \\$TranscriptPath = Join-Path \\$env:TEMP (\"\\$((Get-Date).ToString('yyyyMMdd-HHmmss'))-\\$ScriptName.log\")",
            "    Start-Transcript -Path \\$TranscriptPath -Force | Out-Null",
            "}",
            "",
            "Write-Log -Message \"Starting \\$ScriptName v\\$ScriptVersion\" -Level INFO",
            "Write-Log -Message \"User: \\$env:USERNAME\" -Level DEBUG",
            "Write-Log -Message \"Computer: \\$env:COMPUTERNAME\" -Level DEBUG",
            "Write-Log -Message \"PowerShell Version: \\$($PSVersionTable.PSVersion)\" -Level DEBUG",
            "",
            "try {",
            "    if (\\$PSCmdlet.ShouldProcess(\\$ComputerName, '${4:Perform action}')) {",
            "        ${5:# Logic here}",
            "    }",
            "}",
            "catch {",
            "    \\$ExitCode = 1",
            "    Write-Log -Message \\$_.Exception.Message -Level ERROR",
            "}",
            "finally {",
            "    if (\\$EnableTranscript) {",
            "        Stop-Transcript | Out-Null",
            "    }",
            "}",
            "",
            "Write-Log -Message \"Ending \\$ScriptName with exit code \\$ExitCode\" -Level INFO",
            "exit \\$ExitCode"
        ],
        "description": "Production PowerShell template with strict mode, logging fallback, transcript, admin check, version check, and ShouldProcess"
    }

}



