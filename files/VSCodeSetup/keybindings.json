// Place your key bindings in this file to override the defaults
[
{
        "key": "shift+space",
        "command": "cursorRight",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+space",
        "command": "cursorLeft",
        "when": "editorTextFocus"
    },
    {
        "key": "alt+space",
        "command": "cursorWordEndRight",
        "when": "editorTextFocus"
    },
    {
        "key": "alt+shift+space",
        "command": "cursorWordStartLeft",
        "when": "editorTextFocus"
    }
]